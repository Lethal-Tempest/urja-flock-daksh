  "components": {
    "schemas": {
      "Consumption": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "First local day requested (inclusive). Null if the portal default window was used."
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "Last local day requested (inclusive)."
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Asia/Kolkata"
          },
          "summary": {
            "$ref": "#/components/schemas/ConsumptionSummary"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "start",
          "end",
          "summary",
          "readings"
        ],
        "title": "Consumption"
      },
      "ConsumptionSummary": {
        "properties": {
          "readings": {
            "type": "integer",
            "title": "Readings"
          },
          "interval_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Minutes",
            "description": "Typical spacing of readings: 30 (half-hourly AMI) or 1440 (daily)."
          },
          "first_reading_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Reading At"
          },
          "last_reading_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Reading At"
          },
          "consumed_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumed Kwh",
            "description": "Energy used between the first and last reading."
          },
          "consumed_kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumed Kvah"
          },
          "power_factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor",
            "description": "consumed_kwh / consumed_kvah over the window."
          },
          "voltage_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage Min"
          },
          "voltage_avg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage Avg"
          },
          "voltage_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage Max"
          },
          "missing_intervals": {
            "type": "integer",
            "title": "Missing Intervals",
            "description": "Expected readings absent from the window, given interval_minutes."
          }
        },
        "type": "object",
        "required": [
          "readings",
          "interval_minutes",
          "first_reading_at",
          "last_reading_at",
          "consumed_kwh",
          "consumed_kvah",
          "power_factor",
          "voltage_min",
          "voltage_avg",
          "voltage_max",
          "missing_intervals"
        ],
        "title": "ConsumptionSummary"
      },
      "DataIssue": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "blank",
              "conflict",
              "code_reused",
              "unknown_reference",
              "invalid",
              "not_in_export"
            ],
            "title": "Kind"
          },
          "meter_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
