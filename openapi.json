        ],
        "summary": "Get Network",
        "description": "The reconstructed zone > circle > division > subdivision > substation > feeder > transformer tree.",
        "operationId": "get_network_v1_network_get",
        "parameters": [
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 6,
              "minimum": 0,
              "description": "Levels below zone to include (6 = down to transformers)",
              "default": 6,
              "title": "Depth"
            },
            "description": "Levels below zone to include (6 = down to transformers)"
          }
        ],
        "responses": {
          "200": {
